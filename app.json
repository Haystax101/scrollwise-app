{
  "expo": {
    "name": "Supercharged",
    "slug": "supercharged",
    "scheme": "supercharged",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gdwhastings.scrollwise",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      "expo-updates"
    ],
    "updates": {
      "url": "https://u.expo.dev/75912aaa-18b2-4f42-89ca-8e8bc19698db"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "75912aaa-18b2-4f42-89ca-8e8bc19698db"
      }
    },
    "owner": "gdwhastings"
  }
}
